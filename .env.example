# ===================================================================
# DATABASE & BACKEND CONFIGURATION
# ===================================================================
# Provide your Database or Backend API Base URL below (e.g. Supabase, Firebase, Node/Express, PostgreSQL API, etc.)
# If left blank, the app runs in full offline/persistent LocalStorage mode so all Login & Signup operations work immediately.
# Example: VITE_DATABASE_URL="https://api.yourdomain.com"
VITE_DATABASE_URL=""

# ===================================================================
# AI & APP ENVIRONMENT
# ===================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
